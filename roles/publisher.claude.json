{
  "permissions": {
    "allow": [
      "Read",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr merge *)"
    ],
    "deny": [
      "Edit",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push -f*)",
      "Bash(git push *--delete*)",
      "Bash(git push *--mirror*)",
      "Bash(gh pr merge *--admin*)"
    ]
  }
}
