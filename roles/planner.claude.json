{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(/{project}/.codeumbrella/runs/{run}/papers/spec/**)",
      "Edit(/{project}/.codeumbrella/runs/{run}/papers/tests/**)",
      "Edit(/{project}/.codeumbrella/runs/{run}/papers/pr/**)"
    ],
    "deny": [
      "Bash",
      "WebFetch",
      "WebSearch",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/Library/Keychains/**)"
    ]
  },
  "disableAllHooks": true
}
