{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(git status *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo test *)",
      "Bash(cargo fmt *)",
      "Bash(cargo clippy *)"
    ],
    "deny": [
      "Edit(.codeumbrella/**)",
      "Edit(roles/**)",
      "Edit(graph.yaml)",
      "Edit(.claude/**)",
      "Edit(.github/**)",
      "Edit(.git/hooks/**)",
      "Edit(.git/config)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true
  }
}
