{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash"
    ],
    "deny": [
      "Bash(git push *)",
      "Edit(.codeumbrella/**)",
      "Edit(.claude/**)",
      "Edit(.github/**)",
      "Edit(.git/hooks/**)",
      "Edit(.git/config)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true
  }
}
