{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash"
    ],
    "deny": [
      "Bash(git push *)",
      "Edit(.codeumbrella/**)",
      "Edit(.claude/**)",
      "Edit(.github/**)",
      "Edit(.git/hooks/**)",
      "Edit(.git/config)",
      "Edit(.git/commondir)",
      "Edit(.git/config.worktree)",
      "WebFetch",
      "WebSearch",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/Library/Keychains/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "network": {
      "allowLocalBinding": true
    },
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.config/gh",
        "~/.netrc",
        "~/.git-credentials",
        "~/Library/Keychains"
      ]
    }
  },
  "disableAllHooks": true
}
