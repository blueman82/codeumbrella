#!/bin/sh
# The script of this project for the step `set_version`. Copy it to
# `.codeumbrella/set-version`. It gets the path of the work copy of the run.
# It reads the version of `origin/master` in that copy. It sets the next patch
# version in the version files. It commits only if a file changed. A project
# can also have the version file `fuzz/Cargo.lock`.
#
# It changes only the work copy. It does not fetch and it does not push.
# A worker can write `.git/config` of the work copy, and this script runs with
# no sandbox. So each git call has `-c core.fsmonitor=false`, and a filter in
# that config stops the script with an error. The version must be three
# numbers, a linked file or folder stops the script, and the commit is not
# signed, so no program of that config runs.
set -eu
work=$1
cd "$work"
g() {
  git -c core.fsmonitor=false -c core.hooksPath=/dev/null \
    -c commit.gpgSign=false "$@"
}
# The check reads only the settings of the work copy, with each file that
# they include. The settings of the computer are of the person, for example
# the filter of Git LFS. A worker cannot write them.
# Only the names of a clean clone are good, and `user.name` and `user.email`.
# Each other name can start a command, for example a filter.
names=$(g config --local --includes --list --name-only) || {
  echo "set-version: git cannot read the config of the work copy" >&2
  exit 1
}
names=$(printf '%s\n' "$names" | grep -Evx 'core\.(repositoryformatversion|filemode|bare|logallrefupdates|ignorecase|precomposeunicode|symlinks)|remote\.origin\.(url|fetch)|branch\..*\.(remote|merge)|user\.(name|email)') || true
if [ -n "$names" ]; then
  echo "set-version: the config of the work copy has: $names" >&2
  exit 1
fi
old=$(g show origin/master:Cargo.toml | sed -n 's/^version = "\(.*\)"$/\1/p' | head -n 1)
if ! printf '%s\n' "$old" | grep -Eqx '[0-9]+\.[0-9]+\.[0-9]+'; then
  echo "set-version: origin/master has no version of three numbers" >&2
  exit 1
fi
files="Cargo.toml Cargo.lock .claude-plugin/plugin.json .codex-plugin/plugin.json"
locks=Cargo.lock
if [ -e fuzz/Cargo.lock ]; then
  locks="$locks fuzz/Cargo.lock"
  files="$files fuzz/Cargo.lock"
fi
for path in .claude-plugin .codex-plugin fuzz fuzz/Cargo.lock $files; do
  for one in "$path" "$path.new"; do
    if [ -L "$one" ]; then
      echo "set-version: $one is a link" >&2
      exit 1
    fi
  done
done
for file in $files; do
  if [ ! -f "$file" ]; then
    echo "set-version: $file is not a file" >&2
    exit 1
  fi
  rm -f "$file.new"
done
major=${old%%.*}
rest=${old#*.}
minor=${rest%%.*}
patch=${rest#*.}
new="$major.$minor.$((patch + 1))"
# Cargo.toml: the first `version =` line is the one of the package.
sed "1,/^version = /s/^version = \".*\"/version = \"$new\"/" Cargo.toml > Cargo.toml.new
mv Cargo.toml.new Cargo.toml
# Each lock file: the line after `name = "codeumbrella"`.
for file in $locks; do
  sed "/^name = \"codeumbrella\"\$/{n;s/^version = \".*\"/version = \"$new\"/;}" "$file" > "$file.new"
  mv "$file.new" "$file"
done
for file in .claude-plugin/plugin.json .codex-plugin/plugin.json; do
  sed "s/^\( *\"version\": \)\".*\"/\1\"$new\"/" "$file" > "$file.new"
  mv "$file.new" "$file"
done
# shellcheck disable=SC2086
if ! g diff --quiet --no-ext-diff --no-textconv HEAD -- $files; then
  g add -- $files
  g commit --no-verify --quiet -m "Version $new" -- $files
fi
